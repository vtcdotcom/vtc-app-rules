## ZAPI metered charge (space owner wallet)

**Server routes only** — never expose `ZAPI_INTERNAL_SECRET` to the browser.

| Endpoint | Purpose |
|----------|---------|
| `GET /api/v1/billing/metered-balance?group_id=` | Space owner spendable balance |
| `POST /api/v1/billing/metered-balance-check` | Pre-check `minimum_credits` before LLM call |
| `POST /api/v1/billing/metered-charge` | Debit space owner after successful usage |

Auth: `X-Internal-Secret` = `ZAPI_INTERNAL_SECRET` (local `env_development`) / `BUILD_INTERNAL_SECRET` on platform.

```typescript
// src/lib/meteredCredits.ts — server-only ZAPI client
import { creditsForTokenUsage, estimateTokenWholesaleUsd } from './creditsPricing'

function getZapiBase(): string {
  const url = process.env.VTC_API_URL?.trim() || process.env.POSIF_API_URL?.trim()
  if (!url) throw new Error('VTC_API_URL is not configured')
  return url.replace(/\/$/, '')
}

function getInternalSecret(): string {
  const secret =
    process.env.ZAPI_INTERNAL_SECRET?.trim() ||
    process.env.BUILD_INTERNAL_SECRET?.trim()
  if (!secret) throw new Error('ZAPI_INTERNAL_SECRET is not configured')
  return secret
}

/** Price env per DeepInfra model — bill the model you actually called. */
function priceEnvForModel(model: string): { input: string; output: string } {
  const chatModel = process.env.DEEPINFRA_CHAT_MODEL || 'openai/gpt-oss-120b-Turbo'
  if (model === chatModel || model.includes('gpt-oss')) {
    return { input: 'DEEPINFRA_CHAT_INPUT_PRICE_PER_M', output: 'DEEPINFRA_CHAT_OUTPUT_PRICE_PER_M' }
  }
  return { input: 'DEEPINFRA_INFERENCE_INPUT_PRICE_PER_M', output: 'DEEPINFRA_INFERENCE_OUTPUT_PRICE_PER_M' }
}

export async function fetchSpaceOwnerSpendableCredits(groupId: string): Promise<number> {
  const res = await fetch(
    `${getZapiBase()}/api/v1/billing/metered-balance?group_id=${encodeURIComponent(groupId)}`,
    { headers: { 'X-Internal-Secret': getInternalSecret(), Accept: 'application/json' }, cache: 'no-store' }
  )
  const body = await res.json().catch(() => ({}))
  if (!res.ok) throw new Error(body?.detail || body?.message || 'metered_balance_failed')
  const data = body?.data ?? body
  return Number(data?.spendable_credits ?? 0)
}

export async function assertSpaceOwnerSpendable(groupId: string, minimumCredits: number): Promise<void> {
  const res = await fetch(`${getZapiBase()}/api/v1/billing/metered-balance-check`, {
    method: 'POST',
    headers: {
      'X-Internal-Secret': getInternalSecret(),
      Accept: 'application/json',
      'Content-Type': 'application/json',
    },
    body: JSON.stringify({ group_id: groupId, minimum_credits: minimumCredits }),
  })
  if (res.status === 402) throw new Error('INSUFFICIENT_CREDITS')
  if (!res.ok) {
    const body = await res.json().catch(() => ({}))
    throw new Error(body?.detail || 'metered_balance_check_failed')
  }
}

export async function chargeSpaceOwnerMetered(params: {
  groupId: string
  amountCredits: number
  reason: string
  idempotencyKey: string
  networkId?: string
  triggeredByUserId?: string
  referenceType?: string
  referenceId?: string
  metadata?: Record<string, unknown>
}): Promise<{ ledger_id?: string; balance_credits?: number }> {
  if (params.amountCredits <= 0) return {}

  const moduleCode = process.env.APP_MODULE_CODE?.trim() || process.env.APP_NAME?.trim()
  const res = await fetch(`${getZapiBase()}/api/v1/billing/metered-charge`, {
    method: 'POST',
    headers: {
      'X-Internal-Secret': getInternalSecret(),
      Accept: 'application/json',
      'Content-Type': 'application/json',
      ...(moduleCode ? { 'X-Module-Code': moduleCode } : {}),
    },
    body: JSON.stringify({
      group_id: params.groupId,
      amount_credits: params.amountCredits,
      reason: params.reason,
      idempotency_key: params.idempotencyKey,
      network_id: params.networkId,
      triggered_by_user_id: params.triggeredByUserId,
      reference_type: params.referenceType,
      reference_id: params.referenceId,
      metadata: params.metadata,
      module_code: moduleCode,
    }),
  })

  const body = await res.json().catch(() => ({}))
  if (res.status === 402 || body?.detail === 'insufficient_credits') {
    throw new Error('INSUFFICIENT_CREDITS')
  }
  if (!res.ok) throw new Error(body?.detail || 'metered_charge_failed')

  return {
    ledger_id: body.ledger_id,
    balance_credits: body.balance_credits,
  }
}

/** After successful LLM response — charge space owner from token usage. */
export async function chargeSpaceOwnerForTokenUsage(params: {
  groupId: string
  networkId?: string
  triggeredByUserId?: string
  provider: 'deepinfra'
  model: string
  usage: { prompt_tokens: number; completion_tokens: number }
  idempotencyKey: string
  referenceId: string
}): Promise<number> {
  const keys = priceEnvForModel(params.model)
  const inputPerM = parseFloat(process.env[keys.input] ?? '0')
  const outputPerM = parseFloat(process.env[keys.output] ?? '0')
  if (!inputPerM || !outputPerM) {
    throw new Error(`${params.provider}_price_env_missing`)
  }

  const amount = creditsForTokenUsage(params.usage, inputPerM, outputPerM)
  if (amount <= 0) return 0

  const wholesale = estimateTokenWholesaleUsd(params.usage, inputPerM, outputPerM)
  await chargeSpaceOwnerMetered({
    groupId: params.groupId,
    networkId: params.networkId,
    triggeredByUserId: params.triggeredByUserId,
    amountCredits: amount,
    reason: `AI — ${params.model}`,
    idempotencyKey: params.idempotencyKey,
    referenceType: 'metered_ai',
    referenceId: params.referenceId,
    metadata: {
      provider: params.provider,
      model: params.model,
      tokens_in: params.usage.prompt_tokens,
      tokens_out: params.usage.completion_tokens,
      wholesale_usd: wholesale,
    },
  })
  return amount
}
```

### Typical server route flow

```typescript
// Before LLM call
await assertSpaceOwnerSpendable(user.group_id, 0.01)

// ... call DeepInfra ...

// After success — real usage from provider
await chargeSpaceOwnerForTokenUsage({
  groupId: user.group_id,
  networkId: user.network_id,
  triggeredByUserId: user.user_id,
  provider: 'deepinfra',
  model: 'openai/gpt-oss-120b-Turbo',
  usage: completion.usage,
  idempotencyKey: `ai:${user.group_id}:${messageId}`,
  referenceId: messageId,
})
```

`POST /api/v1/credits/charge` still debits the **JWT user** — use **metered-charge** for space-owner billing.

---

## When to charge

| Usage | When to charge | Billing path |
|-------|----------------|--------------|
| LLM chat / completion | After successful response — token `usage` from provider | App → `metered-charge` |
| RAG embed + rerank | After embed job + after inference — separate line items | App → `metered-charge` |
| Screen Recorder STT (Voxtral) | After successful transcribe — `inference_status.cost` or duration estimate | ZAPI `screen_recording_billing` → space owner |
| Screen Recorder TTS (Orpheus) | After successful re-voice — `inference_status.cost` or character estimate | ZAPI `screen_recording_billing` → space owner |
| MapTiler basemap | **Not metered** — platform absorbs cost | — |
| DeepInfra keys in apps | Server routes only — never browser | App → `metered-charge` |

If provider returns no `usage` / `cost`, use env estimate for pre-check only; for actual charge prefer reported wholesale when available.

---

## Insufficient credits

Return HTTP **402** with `insufficient_credits`. UI: tell user the **space owner** must top up credits (`https://vtc.com` wallet). Do not run the paid API call if pre-check fails.

